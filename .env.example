# ============================================================
# Campus Placement — Frontend stack (docker-compose.yml)
# Copy this file to `.env` (same directory as docker-compose.yml)
# and adjust the values below.
# ============================================================

# ---------- Host port ----------
FRONTEND_PORT=8080

# ---------- Build-time API config ----------
# Base URL the *browser* uses to reach the backend. For local dev keep the
# localhost default; for production use the Render backend:
#   VITE_API_URL=https://backend-campus-placement-portal.onrender.com
#
# --- Deployed on Vercel? ---
# Set VITE_API_URL as an Environment Variable in the Vercel project settings
# (and add it to the build step). The live site
# https://campus-placement-portal.vercel.app already has this set correctly.
VITE_API_URL=http://localhost:6005
VITE_API_VERSION=2
